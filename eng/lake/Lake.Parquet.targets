<Project>
    <!--
      Turns upstream's Parquet.Net project into Lake.Parquet. Only the Lake build imports it, as
      -p:CustomBeforeMicrosoftCommonTargets=<this file>, on a copy whose namespaces
      eng/lake/RenameNamespace.cs has already rewritten. Upstream's own build never sees it, so no
      upstream file has to change (README, "How Lake.Parquet is built").

      CustomBefore, not CustomAfter: it is imported after the project's own properties, so these
      win, but before Microsoft.Common derives TargetName from AssemblyName. Imported any later,
      the assembly would still be Parquet.dll.

      Every project in the build imports it; only the library itself (MSBuildProjectName Parquet)
      is renamed. Test assemblies keep their names, so upstream's InternalsVisibleTo entries hold.
    -->
    <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Parquet'">
        <PackageId>Lake.Parquet</PackageId>
        <AssemblyName>Lake.Parquet</AssemblyName>
        <RootNamespace>Lake.Parquet</RootNamespace>
        <Version>0.1.0</Version>
        <Authors>Ivan Gavryliuk (@aloneguid) and the Parquet.Net contributors, with changes by rtkelly-labs</Authors>
        <Description>A fork of Parquet.Net (aloneguid/parquet-dotnet) that carries upstream plus only the improvements evaluated against it, in the Lake.Parquet namespace. Every change on top of upstream is recorded in docs/changes/.</Description>
        <PackageTags>apache parquet lake lakehouse dotnet c# parquet.net fork</PackageTags>
        <PackageProjectUrl>https://github.com/rtkelly-labs/parquet-dotnet</PackageProjectUrl>
        <RepositoryUrl>https://github.com/rtkelly-labs/parquet-dotnet</RepositoryUrl>
        <PackageReadmeFile>PACKAGE_README.md</PackageReadmeFile>
        <!-- Upstream hard-codes bin\Debug\...\Parquet.xml; the docs must sit beside Lake.Parquet.dll under its name. -->
        <DocumentationFile>bin\$(Configuration)\$(TargetFramework)\Lake.Parquet.xml</DocumentationFile>
    </PropertyGroup>

    <ItemGroup Condition="'$(MSBuildProjectName)' == 'Parquet'">
        <!-- Upstream packs docs/README.md as Parquet.Net's readme; Lake.Parquet has its own. -->
        <None Remove="..\..\docs\README.md" />
        <None Include="$(MSBuildThisFileDirectory)PACKAGE_README.md" Pack="true" PackagePath="\" />
        <!-- MIT asks for the copyright notice in every copy; upstream's package only carries the expression. -->
        <None Include="$(MSBuildThisFileDirectory)..\..\LICENSE" Pack="true" PackagePath="\" />
    </ItemGroup>

    <!--
      The reflection-based serializer is left out of Lake.Parquet (README, "What Lake.Parquet leaves out"): the
      ParquetSerializer, its Dremel striper and assembler compilers and the CLR schema inference they use. Upstream's
      files stay as they are, so rebaselines never conflict on them; they are only not compiled. The attribute types
      in Parquet.Serialization.Attributes stay: Parquet.SourceGenerator recognises them by name. Strip/ holds the one
      method the rest of the library used from those files.
    -->
    <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Parquet' and '$(LakeKeepSerializer)' != 'true'">
        <!-- ParquetOptions' docs link to ParquetSerializer for its serializer-only options -->
        <NoWarn>$(NoWarn);CS1574</NoWarn>
        <!--
          The trimming and AOT analyzers, as errors (the project treats warnings as errors): with the serializer left
          out, Lake.Parquet has no finding, and a change that adds one fails the build. Lake.Parquet.AotTests proves it
          under native AOT.
        -->
        <IsAotCompatible>true</IsAotCompatible>
    </PropertyGroup>
    <ItemGroup Condition="'$(MSBuildProjectName)' == 'Parquet' and '$(LakeKeepSerializer)' != 'true'">
        <Compile Remove="Serialization\ParquetSerializer.cs;Serialization\ParquetClrSchemaExtensions.cs;Serialization\Dremel\**;Extensions\ExpressionExtensions.cs;Utils\FileMerger.cs;Data\RawColumnData.cs" />
        <Compile Include="$(MSBuildThisFileDirectory)Strip\*.cs" />
    </ItemGroup>

    <!--
      The renamed test run leaves out the tests that use the serializer. The plain build's run (the suite job in
      lake.yml) still has every one of them, so tests that also cover other code (encryption, the test-file corpus,
      legacy lists) keep running against the fork.
    -->
    <ItemGroup Condition="'$(MSBuildProjectName)' == 'Parquet.Test' and '$(LakeKeepSerializer)' != 'true'">
        <Compile Remove="Serialisation\**;Integration\ParquetSerializerTest.cs;Extensions\ParquetClrSchemaExtensionsTest.cs;EncryptionTest.cs;ParquetReaderOnTestFilesTest.cs;Reader\ParquetCsvComparison.cs;Reader\TestDataTest.cs;Schema\LegacyListTest.cs;Utils\FIleMergerTest.cs;Extensions\StatsComputeTest.cs" />
        <!--
          RawColumnData only tests use (with ParquetRowGroupReader.ReadRawColumnDataAsync, left out by the manifest):
          compiled into the test assembly instead of the package. LakeRawColumnDataReader.cs stands in for the helper.
        -->
        <Compile Include="..\Parquet\Data\RawColumnData.cs" />
    </ItemGroup>
</Project>
