<Project Sdk="Microsoft.NET.Sdk">

    <!--
      The tool that keeps Lake.Parquet's change stack: upstream's history with one commit per change on
      top, rebased onto upstream continually. docs/maintaining.md is the guide and lists the commands
      (run it with dotnet run and the project eng/lake/Lake.Stack).

      It is the fork's own (lake(0001)) and stays out of upstream's solution, so upstream's build never
      sees it. Its tests are in eng/lake/Lake.Stack.Tests.
    -->

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <RootNamespace>Lake.Stack</RootNamespace>
        <InvariantGlobalization>true</InvariantGlobalization>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="System.CommandLine" Version="2.0.11" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Lake.Stack.Tests" />
    </ItemGroup>

</Project>
