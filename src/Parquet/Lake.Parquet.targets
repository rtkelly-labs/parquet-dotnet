<Project>
  <!--
    Lake.Parquet's identity, on top of upstream Parquet.Net's project file.

    Everything that makes this fork a different package lives here, imported by the last line of Parquet.csproj, so
    upstream changes to Parquet.csproj merge without conflicts (docs/lake/maintaining.md). The C# namespace stays
    `Parquet`, as upstream's: the source keeps matching upstream line for line, which is what lets upstream updates
    merge in and the patches in docs/upstream apply there. Lake.Parquet therefore replaces Parquet.Net in a
    project; the two cannot be referenced together.
  -->
  <PropertyGroup>
    <PackageId>Lake.Parquet</PackageId>
    <AssemblyName>Lake.Parquet</AssemblyName>
    <RootNamespace>Parquet</RootNamespace>
    <Product>Lake.Parquet</Product>
    <!-- the version comes from the first heading of docs/lake/release-notes.md (.github/workflows/lake.yml) -->
    <Authors>Ryan Kelly (rtkelly-labs); Parquet.Net by Ivan Gavryliuk (@aloneguid)</Authors>
    <Description>Apache Parquet for .NET for table formats (Iceberg, DuckLake): a fork of Parquet.Net with field IDs on every field, modular encryption, statistics in each type's sort order with column orders, typed statistics, physical values, FIXED_LEN_BYTE_ARRAY(n) and faster reads. Replaces Parquet.Net (same Parquet namespace).</Description>
    <PackageTags>apache parquet lakehouse iceberg ducklake dotnet c# encryption</PackageTags>
    <PackageProjectUrl>https://github.com/rtkelly-labs/parquet-dotnet</PackageProjectUrl>
    <RepositoryUrl>https://github.com/rtkelly-labs/parquet-dotnet</RepositoryUrl>
    <!-- the documentation file follows the assembly name, so IntelliSense finds it next to Lake.Parquet.dll -->
    <DocumentationFile></DocumentationFile>

    <!-- The upstream commit this release is based on; scripts/lake/sync-upstream.sh updates these. -->
    <LakeUpstreamRepository>https://github.com/aloneguid/parquet-dotnet</LakeUpstreamRepository>
    <LakeUpstreamCommit>658e1cafebdd1d80d6833c40b0f387d0769898c8</LakeUpstreamCommit>
    <LakeUpstreamVersion>6.1.1-pre.2</LakeUpstreamVersion>
    <PackageReleaseNotes>Based on Parquet.Net $(LakeUpstreamVersion) ($(LakeUpstreamRepository)/commit/$(LakeUpstreamCommit)). See docs/lake/release-notes.md.</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="..\..\docs\README.md" />
    <None Include="..\..\docs\lake\README.md" Pack="true" PackagePath="\" />
    <!-- MIT: the copyright notice travels with every copy -->
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
    <AssemblyMetadata Include="LakeUpstreamRepository" Value="$(LakeUpstreamRepository)" />
    <AssemblyMetadata Include="LakeUpstreamCommit" Value="$(LakeUpstreamCommit)" />
    <AssemblyMetadata Include="LakeUpstreamVersion" Value="$(LakeUpstreamVersion)" />
  </ItemGroup>
</Project>
